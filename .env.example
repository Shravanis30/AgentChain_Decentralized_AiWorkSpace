# ==========================================
# AgentChain - Local Environment Configuration
# ==========================================
# Copy this file to .env for local development:
#   cp .env.example .env
# NEVER commit .env to version control!

# --- Application Core ---
APP_NAME=AgentChain
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
SECRET_KEY=dev_insecure_secret_key_change_in_production_min32chars
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- PostgreSQL 16 ---
POSTGRES_USER=agentchain_user
POSTGRES_PASSWORD=agentchain_dev_password
POSTGRES_DB=agentchain_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://agentchain_user:agentchain_dev_password@localhost:5432/agentchain_db
DATABASE_SYNC_URL=postgresql://agentchain_user:agentchain_dev_password@localhost:5432/agentchain_db

# --- Redis 7 ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# --- Qdrant Vector DB ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- MinIO Object Storage (S3-Compatible) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=agentchain-artifacts
S3_REGION=us-east-1

# --- Blockchain / Network & Contracts ---
# Local Anvil (Default for dev/testing):
# Chain ID: 31337
# RPC: http://localhost:8545
# Default Anvil Account #0 for local testing only:
# 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
ANVIL_PORT=8545
RPC_URL=http://localhost:8545
CHAIN_ID=31337
DEPLOYER_PRIVATE_KEY=<DEPLOYER_PRIVATE_KEY>
SIGNER_PROVIDER=aws_kms
AWS_REGION=<AWS_REGION>
AWS_KMS_KEY_ARN=<AWS_KMS_KEY_ARN>
EXPECTED_SIGNER_ADDRESS=<EXPECTED_ETHEREUM_ADDRESS>

# Role Addresses (defaults to deployer for local testing if unset):
ADMIN_ADDRESS=
ARBITRATOR_ADDRESS=
PAUSER_ADDRESS=

# Payment Token Configuration:
# - Local Anvil: Leave blank to deploy MockUSDC automatically
# - Base Sepolia (Chain ID 84532): 0x036CbD53842c5426634e7929541eC2318f3dCF7e (Official Circle Native USDC)
# - Base Mainnet (Chain ID 8453): 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913 (Official Circle Native USDC - BLOCKED in Phase 6.1)
USDC_ADDRESS=

# Contract Verification (Basescan / Etherscan API key):
ETHERSCAN_API_KEY=

# --- Frontend Web Application ---
NEXT_PUBLIC_APP_NAME=AgentChain
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_RPC_URL=http://localhost:8545
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_ENABLE_TESTNETS=true
