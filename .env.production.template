# ==============================================================================
# AgentChain - Production Configuration Template
# ==============================================================================
# STRICT SAFETY INVARIANTS:
# 1. NEVER commit a populated version of this file to version control.
# 2. Production execution MUST NOT rely on raw private keys.
# 3. Only KMS / HSM / MPC signer backends are permitted in production.
# 4. All addresses must be explicitly configured (no implicit fallbacks).
# 5. Base Mainnet (Chain ID 8453) remains HARD BLOCKED until formal governance release.
# ==============================================================================

# --- Environment Separation ---
# Allowed: 'production' | 'testnet' | 'development'
APP_ENV=production
DEBUG=false

# --- Network & Chain Binding ---
# Base Sepolia: 84532 | Base Mainnet: 8453 (HARD BLOCKED)
CHAIN_ID=84532
RPC_URL=https://<SECURE_RPC_ENDPOINT_OR_NODE_PROVIDER>

# --- Production Secure Signer (AWS KMS / HSM / MPC) ---
# MUST NOT BE 'raw_key' or 'local_account' in production.
# Permitted providers: 'aws_kms' | 'kms' | 'hsm' | 'mpc'
SIGNER_PROVIDER=aws_kms
AWS_REGION=<AWS_REGION>
AWS_KMS_KEY_ARN=<AWS_KMS_KEY_ARN>
SIGNER_KEY_REFERENCE=<AWS_KMS_KEY_ARN>
EXPECTED_SIGNER_ADDRESS=<EXPECTED_ETHEREUM_ADDRESS>

# --- Canonical Protocol Contracts ---
AGENT_REGISTRY_ADDRESS=0x96C3945e264A880EbaB5e95fDF786Fc18A4389B5
REVENUE_DISTRIBUTOR_ADDRESS=0x2F2d5Cc40e2C4C32cC86BC5127c2833a7784ee1c
ESCROW_ADDRESS=0x3e5C09D2123cA106b2E24C4f76bFad4a022640D1
RESULT_NOTARY_ADDRESS=0xed58B4E37f81dFbD08c3d2DeF613286bC8Cf8056
REPUTATION_REGISTRY_ADDRESS=0x423856529583F536d5dFaE80f7Bc142075c6Fc71
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# --- Role Separation & Identity ---
# No role address may match the Anvil default address (0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266).
RELAYER_ROLE_ADDRESS=0x<SECURE_RELAYER_OPERATOR_ADDRESS>
ADMIN_ROLE_ADDRESS=0x<SECURE_MULTI_SIG_ADMIN_ADDRESS>
ARBITRATOR_ROLE_ADDRESS=0x<SECURE_ARBITRATOR_ADDRESS>
PAUSER_ROLE_ADDRESS=0x<SECURE_PAUSER_ADDRESS>
NOTARIZER_ROLE_ADDRESS=0x<SECURE_NOTARIZER_ADDRESS>

# --- Database & Storage (Vault / Secret Manager References) ---
DATABASE_URL=postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>
REDIS_URL=rediss://<REDIS_AUTH>@<REDIS_HOST>:6379/0
QDRANT_URL=https://<QDRANT_HOST>:6333
QDRANT_API_KEY=<QDRANT_SECRET_API_KEY>
S3_ENDPOINT_URL=https://s3.<REGION>.amazonaws.com
S3_ACCESS_KEY_ID=<S3_KEY_ID>
S3_SECRET_ACCESS_KEY=<S3_SECRET_KEY>
S3_BUCKET_NAME=<PRODUCTION_ARTIFACTS_BUCKET>
